# Copy this file to backend/.env and fill in real values. Never commit backend/.env.

# --- API keys ---
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key
USDA_API_KEY=DEMO_KEY
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1

# --- Cloudflare R2 (S3-compatible object storage for photos) ---
# Endpoint looks like https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cybernetic_gym_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password
# Async driver (postgresql+asyncpg://) is applied automatically by the app;
# alembic downgrades this to a sync driver on its own.
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/cybernetic_gym_assistant
# The integration tests create this database and drop every table in it on each run.
# Leave it empty to use DATABASE_URL with a _test suffix.
TEST_DATABASE_URL=

# --- Password reset email ---
# Where the reset link points: the frontend origin, not the API's.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=60
# Any SMTP server. With SMTP_HOST empty the reset link is written to the log at WARNING
# instead of being emailed, and the flow still works for whoever can read the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Models ---
PRIMARY_MODEL=gpt-4o-mini
GEMINI_VISION_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=text-embedding-3-large

# --- RAG ---
CHUNK_SIZE=512
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=8
RERANKING_TOP_N=4
# Cosine floor for "the course covers this". Model-specific — recalibrate if you change
# EMBEDDING_MODEL. Measured for text-embedding-3-large: on-topic chunks >= 0.47,
# off-topic ones <= 0.31.
RETRIEVAL_MIN_SCORE=0.38

# --- App ---
APP_ENV=development
# Generate a strong random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# --- Language of AI responses ---
RESPONSE_LANGUAGE=bulgarian
